{
  "rules": [
    {
      "id": "MT-SERVICE-FTP",
      "description": "FTP management service is enabled",
      "severity": "high",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/ip service$",
      "must_not_contain": ["(?s)^/ip service$\\n(?:(?!^/).)*^set ftp disabled=no\\b"],
      "remediation": "If FTP is not required, disable it: /ip service set ftp disabled=yes"
    },
    {
      "id": "MT-SERVICE-TELNET",
      "description": "Telnet management service is enabled",
      "severity": "high",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/ip service$",
      "must_not_contain": ["(?s)^/ip service$\\n(?:(?!^/).)*^set telnet disabled=no\\b"],
      "remediation": "If Telnet is not required, disable it and use SSH: /ip service set telnet disabled=yes"
    },
    {
      "id": "MT-SERVICE-WWW",
      "description": "HTTP web management service is enabled",
      "severity": "medium",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/ip service$",
      "must_not_contain": ["(?s)^/ip service$\\n(?:(?!^/).)*^set www disabled=no\\b"],
      "remediation": "If web management is not required, disable it: /ip service set www disabled=yes"
    },
    {
      "id": "MT-SERVICE-API",
      "description": "API management service is enabled",
      "severity": "medium",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/ip service$",
      "must_not_contain": ["(?s)^/ip service$\\n(?:(?!^/).)*^set api disabled=no\\b"],
      "remediation": "If API is not required, disable it: /ip service set api disabled=yes"
    },
    {
      "id": "MT-SERVICE-API-SSL",
      "description": "API-SSL management service is enabled",
      "severity": "medium",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/ip service$",
      "must_not_contain": ["(?s)^/ip service$\\n(?:(?!^/).)*^set api-ssl disabled=no\\b"],
      "remediation": "If API-SSL is not required, disable it: /ip service set api-ssl disabled=yes"
    },
    {
      "id": "MT-PPTP-ENABLED",
      "description": "PPTP VPN server is enabled; PPTP is considered insecure",
      "severity": "high",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/interface pptp-server server$",
      "must_not_contain": ["(?s)^/interface pptp-server server$\\n(?:(?!^/).)*^set .*\\benabled=yes\\b"],
      "remediation": "Prefer a modern VPN protocol; plan and test migration before disabling PPTP"
    },
    {
      "id": "MT-NTP-CONFIGURED",
      "description": "RouterOS NTP client server is configured",
      "severity": "low",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/system ntp client servers$",
      "must_contain": ["(?s)^/system ntp client servers$\\n(?:(?!^/).)*^add .*\\baddress=\\S+"],
      "remediation": "Configure an approved NTP server under /system ntp client servers"
    },
    {
      "id": "MT-REMOTE-SYSLOG",
      "description": "Remote syslog action is configured",
      "severity": "medium",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/system logging action$",
      "must_contain": ["(?s)^/system logging action$\\n(?:(?!^/).)*^add .*\\btarget=remote\\b.*\\bremote=\\S+"],
      "remediation": "Configure a remote logging action and route the required topics to it"
    },
    {
      "id": "MT-SNMP-ENABLED",
      "description": "SNMP service is enabled",
      "severity": "medium",
      "platforms": ["mikrotik_routeros"],
      "scope_pattern": "(?m)^/snmp$",
      "must_not_contain": ["(?s)^/snmp$\\n(?:(?!^/).)*^set .*\\benabled=yes\\b"],
      "remediation": "Disable SNMP if not required; otherwise restrict access and use SNMPv3 where supported"
    }
  ]
}
