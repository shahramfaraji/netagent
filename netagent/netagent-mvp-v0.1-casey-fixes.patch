+    def _write_temp(directory: Path, content: str) -> Path:
+        fd, name = tempfile.mkstemp(prefix=".netagent-", suffix=".tmp", dir=directory)
+        path = Path(name)
+        try:
+            os.fchmod(fd, 0o600)
+            stream = os.fdopen(fd, "w", encoding="utf-8")
+            fd = -1  # Ownership transferred to the file object.
+            with stream:
