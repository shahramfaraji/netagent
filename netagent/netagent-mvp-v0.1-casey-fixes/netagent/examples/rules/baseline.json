{
  "rules": [
    {"id": "SSH-V2", "description": "SSH must be version 2", "severity": "high",
     "platforms": ["cisco_ios"], "must_contain": ["^ip ssh version 2"], "remediation": "ip ssh version 2"},
    {"id": "NO-TELNET", "description": "Telnet must be disabled on VTY", "severity": "critical",
     "platforms": ["cisco_ios"], "must_not_contain": ["transport input .*telnet", "transport input all"],
     "remediation": "line vty 0 15\n transport input ssh"},
    {"id": "PASSWORD-ENCRYPTION", "description": "Service password-encryption enabled", "severity": "medium",
     "platforms": ["cisco_ios"], "must_contain": ["^service password-encryption"], "remediation": "service password-encryption"},
    {"id": "NTP", "description": "NTP server configured", "severity": "low",
     "must_contain": ["^ntp server \\S+"], "remediation": "ntp server <ip>"},
    {"id": "LOGGING", "description": "Remote syslog configured", "severity": "medium",
     "must_contain": ["^logging (host )?\\d+\\.\\d+\\.\\d+\\.\\d+"], "remediation": "logging host <ip>"},
    {"id": "NO-SNMP-PUBLIC", "description": "No default SNMP communities", "severity": "high",
     "must_not_contain": ["snmp-server community (public|private)\\b"], "remediation": "no snmp-server community public"}
  ]
}
